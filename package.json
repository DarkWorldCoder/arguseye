{
  "name": "component-preview",
  "displayName": "Component Preview",
  "description": "See any React, Next.js or Vue component live beside your code, as it looks in your app. No dev server.",
  "version": "0.0.1",
  "publisher": "ayushniroula",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vscode": "npm run build && node test/vscode/run.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "package": "npm run build && vsce package --target linux-x64 --allow-missing-repository",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "cjs-module-lexer": "^2.3.0",
    "es-module-lexer": "^3.0.4",
    "lightningcss": "^1.33.0",
    "oxc-parser": "^0.156.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.156.0",
    "playwright-core": "^1.64.1",
    "react-refresh": "^0.19.0",
    "rolldown": "^1.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "component-preview": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "shims",
    "skills",
    "README.md",
    "LICENSE",
    "node_modules/**"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:vue"
  ],
  "contributes": {
    "commands": [
      {
        "command": "componentPreview.open",
        "title": "Preview Component",
        "category": "Component Preview",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "componentPreview.open",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(tsx|jsx|vue)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "componentPreview.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushniroula/component-preview"
  },
  "keywords": [
    "react",
    "nextjs",
    "vue",
    "component",
    "preview",
    "mcp",
    "agent",
    "claude",
    "codex",
    "cursor",
    "screenshot"
  ]
}
