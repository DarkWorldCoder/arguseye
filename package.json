    "lightningcss": "^1.33.0",
    "oxc-parser": "^0.156.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.156.0",
    "playwright-core": "^1.64.1",
    "react-refresh": "^0.19.0",
    "rolldown": "^1.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
