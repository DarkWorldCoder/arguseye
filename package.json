{
  "name": "arguseye",
  "displayName": "Arguseye",
  "description": "Render React, browser-compatible Next.js, and Vue components from real source. Visual evidence for coding agents and VS Code, without starting the app.",
  "version": "0.0.4",
  "publisher": "ayushniroula",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vscode": "npm run build && node test/vscode/run.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "package": "npm run build && vsce package --target linux-x64 --allow-missing-repository --readme-path README.marketplace.md",
    "prepublishOnly": "npm run build",
    "pack:npm": "npm run build && node scripts/packNpm.mjs",
    "publish:npm": "npm run build && node scripts/packNpm.mjs --publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "cjs-module-lexer": "^2.3.0",
    "es-module-lexer": "^3.0.4",
    "lightningcss": "^1.33.0",
    "oxc-parser": "^0.156.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.156.0",
    "playwright-core": "^1.64.1",
    "react-refresh": "^0.19.0",
    "rolldown": "^1.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "arguseye": "dist/cli.mjs"
  },
  "files": [
    "README.marketplace.md",
    "dist",
    "shims",
    "skills",
    "assets",
    "docs/install.md",
    "docs/product.md",
    "docs/technique.md",
    "docs/agent-wishlist.md",
    "benchmarks/README.md",
    "benchmarks/latest.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "LICENSE",
    "node_modules/**"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:vue"
  ],
  "contributes": {
    "commands": [
      {
        "command": "componentPreview.open",
        "title": "Preview Component",
        "category": "Arguseye",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "componentPreview.open",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(tsx|jsx|vue)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "componentPreview.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkWorldCoder/arguseye.git"
  },
  "keywords": [
    "react",
    "nextjs",
    "vue",
    "component",
    "preview",
    "mcp",
    "agent",
    "claude",
    "codex",
    "cursor",
    "screenshot"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "homepage": "https://darkworldcoder.github.io/arguseye/",
  "bugs": {
    "url": "https://github.com/DarkWorldCoder/arguseye/issues"
  },
  "author": "Ayush Niroula"
}
