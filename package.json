{
  "name": "arguseye",
  "displayName": "Arguseye",
  "description": "Preview real components and native Django, Jinja2, Handlebars, PHP and Ruby templates. Inspect UI edits from coding agents and VS Code without starting the app.",
  "version": "0.0.18",
  "mcpName": "io.github.DarkWorldCoder/arguseye",
  "publisher": "ayushniroula",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vscode": "npm run build && node test/vscode/run.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "package": "npm run build && vsce package --target linux-x64 --allow-missing-repository --readme-path README.marketplace.md",
    "prepublishOnly": "npm run build",
    "pack:npm": "npm run build && node scripts/packNpm.mjs",
    "publish:npm": "npm run build && node scripts/packNpm.mjs --publish"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "axe-core": "4.14.0",
    "cjs-module-lexer": "^2.3.0",
    "es-module-lexer": "^3.0.4",
    "jsonc-parser": "3.3.1",
    "lightningcss": "^1.33.0",
    "oxc-parser": "^0.156.0",
    "oxc-resolver": "^11.24.2",
    "oxc-transform": "^0.156.0",
    "parse5": "8.0.1",
    "playwright-core": "^1.64.1",
    "react-refresh": "^0.19.0",
    "rolldown": "^1.2.15",
    "toml-eslint-parser": "0.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "arguseye": "dist/cli.mjs"
  },
  "files": [
    "README.marketplace.md",
    "dist",
    "shims",
    "skills",
    "assets",
    "docs/install.md",
    "docs/product.md",
    "docs/templates.md",
    "docs/setup.md",
    "docs/rendering.md",
    "docs/conformance.md",
    "docs/technique.md",
    "docs/agent-wishlist.md",
    "benchmarks/README.md",
    "benchmarks/latest.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "LICENSE",
    "node_modules/**"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "componentPreview.open",
        "title": "Preview Component",
        "category": "Arguseye",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "componentPreview.open",
          "group": "navigation",
          "when": "isWorkspaceTrusted && resourceScheme == file && !explorerResourceIsFolder && resourceExtname =~ /\\.(tsx|jsx|vue|svelte|html|js|mjs|cjs|tpl|django|dtl|jinja2|jinja|j2|mako|tornado|handlebars|hbs|mustache|ejs|pug|jade|nunjucks|njk|liquid|eta|dot|jst|twig|php|smarty|latte|erb|haml|slim)$/"
        }
      ],
      "editor/context": [
        {
          "command": "componentPreview.open",
          "group": "navigation@20",
          "when": "isWorkspaceTrusted && resourceScheme == file && !explorerResourceIsFolder && resourceExtname =~ /\\.(tsx|jsx|vue|svelte|html|js|mjs|cjs|tpl|django|dtl|jinja2|jinja|j2|mako|tornado|handlebars|hbs|mustache|ejs|pug|jade|nunjucks|njk|liquid|eta|dot|jst|twig|php|smarty|latte|erb|haml|slim)$/"
        }
      ],
      "editor/title/context": [
        {
          "command": "componentPreview.open",
          "group": "navigation@20",
          "when": "isWorkspaceTrusted && resourceScheme == file && !explorerResourceIsFolder && resourceExtname =~ /\\.(tsx|jsx|vue|svelte|html|js|mjs|cjs|tpl|django|dtl|jinja2|jinja|j2|mako|tornado|handlebars|hbs|mustache|ejs|pug|jade|nunjucks|njk|liquid|eta|dot|jst|twig|php|smarty|latte|erb|haml|slim)$/"
        }
      ],
      "explorer/context": [
        {
          "command": "componentPreview.open",
          "group": "navigation@20",
          "when": "isWorkspaceTrusted && resourceScheme == file && !explorerResourceIsFolder && resourceExtname =~ /\\.(tsx|jsx|vue|svelte|html|js|mjs|cjs|tpl|django|dtl|jinja2|jinja|j2|mako|tornado|handlebars|hbs|mustache|ejs|pug|jade|nunjucks|njk|liquid|eta|dot|jst|twig|php|smarty|latte|erb|haml|slim)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "componentPreview.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Arguseye",
      "properties": {
        "arguseye.buildMode": {
          "type": "string",
          "enum": [
            "native",
            "vite"
          ],
          "default": "native",
          "markdownDescription": "Native keeps the fast per-file compiler. Vite explicitly executes the project's installed Vite config/plugins in a separate process. Compatibility edits reload the preview and reset state. Reload the VS Code window after changing this setting."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkWorldCoder/arguseye.git"
  },
  "keywords": [
    "react",
    "nextjs",
    "vue",
    "svelte",
    "react-router",
    "remix",
    "component",
    "preview",
    "mcp",
    "agent",
    "claude",
    "codex",
    "cursor",
    "screenshot",
    "lit",
    "web-components",
    "html",
    "django",
    "jinja2",
    "handlebars",
    "templates"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "homepage": "https://darkworldcoder.github.io/arguseye/",
  "bugs": {
    "url": "https://github.com/DarkWorldCoder/arguseye/issues"
  },
  "author": "Ayush Niroula"
}
